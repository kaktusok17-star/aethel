#!/bin/sh
case "$1" in
    deconfig)
        ip addr flush dev "$interface" 2>/dev/null
        ;;
    bound|renew)
        ip addr add "$ip/${subnet:-24}" dev "$interface" 2>/dev/null
        [ -n "$router" ] && ip route add default via "$router" 2>/dev/null
        : > /etc/resolv.conf
        for ns in $dns; do
            echo "nameserver $ns" >> /etc/resolv.conf
        done
        ;;
    leasefail|nak)
        ;;
esac
